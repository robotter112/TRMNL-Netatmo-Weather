{%- comment -%} Zeitzone kommt aus APP_TIMEZONE (Europe/Berlin), Sommerzeit automatisch. {%- endcomment -%}
{%- assign tzoff = 0 -%}
{%- comment -%} ---------- Sprache / language ---------- {%- endcomment -%}
{%- assign LANG = trmnl.plugin_settings.custom_fields_values.lang | default: 'de' -%}
{%- if LANG == 'en' -%}
  {%- assign L_out='Outside' -%}{%- assign L_in='Inside' -%}
  {%- assign L_batt='Battery' -%}{%- assign L_offline='Module offline' -%}
  {%- assign L_hum='humidity' -%}{%- assign L_co2now='CO&#8322; now' -%}
  {%- assign L_tchart='Outside temperature' -%}{%- assign L_cchart='CO&#8322; inside' -%}
  {%- assign L_win='Window' -%}{%- assign L_open='open' -%}{%- assign L_closed='closed' -%}
  {%- assign C1='Fresh air' -%}{%- assign C2='Good' -%}{%- assign C3='Ventilate soon' -%}
  {%- assign C4='Ventilate' -%}{%- assign C5='Ventilate now!' -%}
  {%- assign W1='CO&#8322; critical' -%}{%- assign W2='CO&#8322; high' -%}
  {%- assign W3='cools down' -%}{%- assign W4='warmer outside' -%}{%- assign W5='all good' -%}
  {%- assign N1='Frost' -%}{%- assign N2='Risk of frost' -%}
  {%- assign N3='Extreme heat' -%}{%- assign N4='Heat' -%}
  {%- assign L_nodata='No readings' -%}
  {%- assign L_nodata2='Home Assistant reports all sensors as unavailable' -%}
{%- else -%}
  {%- assign L_out='Draussen' -%}{%- assign L_in='Innen' -%}
  {%- assign L_batt='Akku' -%}{%- assign L_offline='Modul offline' -%}
  {%- assign L_hum='Luftfeuchte' -%}{%- assign L_co2now='CO&#8322; jetzt' -%}
  {%- assign L_tchart='Temperatur draussen' -%}{%- assign L_cchart='CO&#8322; innen' -%}
  {%- assign L_win='Fenster' -%}{%- assign L_open='auf' -%}{%- assign L_closed='zu' -%}
  {%- assign C1='Frische Luft' -%}{%- assign C2='Gut' -%}{%- assign C3='Bald lüften' -%}
  {%- assign C4='Lüften' -%}{%- assign C5='Sofort lüften!' -%}
  {%- assign W1='CO&#8322; kritisch' -%}{%- assign W2='CO&#8322; hoch' -%}
  {%- assign W3='k&uuml;hlt ab' -%}{%- assign W4='drau&szlig;en w&auml;rmer' -%}{%- assign W5='passt so' -%}
  {%- assign N1='Frost' -%}{%- assign N2='Frostgefahr' -%}
  {%- assign N3='Starke Hitze' -%}{%- assign N4='Hitze' -%}
  {%- assign L_nodata='Keine Messwerte' -%}
  {%- assign L_nodata2='Home Assistant meldet alle Sensoren als nicht verf&uuml;gbar' -%}
{%- endif -%}

{%- comment -%} ---------- Ausfaelle abfangen ----------
   Home Assistant liefert bei einem Ausfall den **Text** „unavailable" oder
   „unknown" statt einer Zahl. `| times: 1.0` wirft darauf eine interne
   Ausnahme, und LaraPaper malt den Fehlertext gross aufs Blatt — genau so
   gesehen, als die Netatmo-Anbindung wegbrach: neun von elf Messwerten waren
   Text, und aus dem Wetterblatt wurde eine Wand aus „Liquid error".
   In den Verlaufsschleifen weiter unten war der Fall laengst abgefangen, bei
   den Momentanwerten nicht. Jeder Wert wird deshalb hier **einmal** geprueft;
   danach benutzt das Blatt nur noch `v_*` und `has_*`. {%- endcomment -%}
{%- assign MISS = 'unavailable,unknown,none,null,nan' | split: ',' -%}
{%- assign DASH = '&ndash;' -%}

{%- assign v_tout = 0.0 -%}{%- assign has_tout = false -%}
{%- assign s = IDX_0.state | downcase -%}
{%- unless s == blank or MISS contains s -%}
  {%- assign v_tout = IDX_0.state | times: 1.0 -%}{%- assign has_tout = true -%}
{%- endunless -%}

{%- assign v_hout = 0.0 -%}{%- assign has_hout = false -%}
{%- assign s = IDX_1.state | downcase -%}
{%- unless s == blank or MISS contains s -%}
  {%- assign v_hout = IDX_1.state | times: 1.0 -%}{%- assign has_hout = true -%}
{%- endunless -%}

{%- assign v_tin = 0.0 -%}{%- assign has_tin = false -%}
{%- assign s = IDX_2.state | downcase -%}
{%- unless s == blank or MISS contains s -%}
  {%- assign v_tin = IDX_2.state | times: 1.0 -%}{%- assign has_tin = true -%}
{%- endunless -%}

{%- assign v_hin = 0.0 -%}{%- assign has_hin = false -%}
{%- assign s = IDX_3.state | downcase -%}
{%- unless s == blank or MISS contains s -%}
  {%- assign v_hin = IDX_3.state | times: 1.0 -%}{%- assign has_hin = true -%}
{%- endunless -%}

{%- assign v_co2 = 0.0 -%}{%- assign has_co2 = false -%}
{%- assign s = IDX_4.state | downcase -%}
{%- unless s == blank or MISS contains s -%}
  {%- assign v_co2 = IDX_4.state | times: 1.0 -%}{%- assign has_co2 = true -%}
{%- endunless -%}

{%- assign v_batt = 0.0 -%}{%- assign has_batt = false -%}
{%- assign s = IDX_8.state | downcase -%}
{%- unless s == blank or MISS contains s -%}
  {%- assign v_batt = IDX_8.state | times: 1.0 -%}{%- assign has_batt = true -%}
{%- endunless -%}

{%- comment -%} Fehlt alles, hat das Blatt nichts zu zeigen. Dann lieber ein
   klarer Hinweis als eine Seite voller Striche. {%- endcomment -%}
{%- assign nodata = false -%}
{%- unless has_tout or has_tin or has_co2 -%}{%- assign nodata = true -%}{%- endunless -%}

{%- assign tpts = IDX_7.data | first -%}
{%- assign cpts = IDX_9.data | first -%}

{%- assign f = tpts | first -%}{%- assign l = tpts | last -%}
{%- assign t0s = f.last_changed | date: "%s" | times: 1 -%}
{%- assign t1s = l.last_changed | date: "%s" | times: 1 -%}
{%- assign tdur = t1s | minus: t0s -%}{%- if tdur <= 0 -%}{%- assign tdur = 86400 -%}{%- endif -%}

{%- assign tmin = 9999.0 -%}{%- assign tmax = -9999.0 -%}
{%- for p in tpts -%}{%- if p.state != 'unavailable' and p.state != 'unknown' -%}
  {%- assign v = p.state | times: 1.0 -%}
  {%- if v < tmin -%}{%- assign tmin = v -%}{%- endif -%}
  {%- if v > tmax -%}{%- assign tmax = v -%}{%- endif -%}
{%- endif -%}{%- endfor -%}
{%- assign tspan = tmax | minus: tmin -%}{%- if tspan <= 0 -%}{%- assign tspan = 1.0 -%}{%- endif -%}
{%- assign tmid = tmax | plus: tmin | divided_by: 2.0 -%}

{%- assign cmin = 99999.0 -%}{%- assign cmax = -99999.0 -%}
{%- for p in cpts -%}{%- if p.state != 'unavailable' and p.state != 'unknown' -%}
  {%- assign v = p.state | times: 1.0 -%}
  {%- if v < cmin -%}{%- assign cmin = v -%}{%- endif -%}
  {%- if v > cmax -%}{%- assign cmax = v -%}{%- endif -%}
{%- endif -%}{%- endfor -%}
{%- assign cspan = cmax | minus: cmin -%}{%- if cspan <= 0 -%}{%- assign cspan = 1.0 -%}{%- endif -%}
{%- assign cmid = cmax | plus: cmin | divided_by: 2.0 -%}

{%- capture tpoly -%}{%- for p in tpts -%}{%- if p.state != 'unavailable' and p.state != 'unknown' -%}
{%- assign v = p.state | times: 1.0 -%}
{%- assign dx = p.last_changed | date: "%s" | times: 1 | minus: t0s -%}
{%- assign x = dx | times: 882.0 | divided_by: tdur | plus: 78 -%}
{%- assign y = tmax | minus: v | times: 149.0 | divided_by: tspan | plus: 16 -%}
{{ x | round: 1 }},{{ y | round: 1 }} {% endif -%}{%- endfor -%}{%- endcapture -%}

{%- capture cpoly -%}{%- for p in cpts -%}{%- if p.state != 'unavailable' and p.state != 'unknown' -%}
{%- assign v = p.state | times: 1.0 -%}
{%- assign dx = p.last_changed | date: "%s" | times: 1 | minus: t0s -%}
{%- if dx >= 0 -%}
{%- assign x = dx | times: 882.0 | divided_by: tdur | plus: 78 -%}
{%- assign y = cmax | minus: v | times: 152.0 | divided_by: cspan | plus: 16 -%}
{{ x | round: 1 }},{{ y | round: 1 }} {% endif -%}{%- endif -%}{%- endfor -%}{%- endcapture -%}

{%- assign step = tdur | divided_by: 4 -%}
{%- assign k1 = t0s | plus: step -%}
{%- assign k2 = k1 | plus: step -%}
{%- assign k3 = k2 | plus: step -%}

{%- assign tnow = v_tout -%}
{%- assign tcy = tmax | minus: tnow | times: 149.0 | divided_by: tspan | plus: 16 -%}
{%- assign co2 = v_co2 -%}
{%- assign ccy = cmax | minus: co2 | times: 152.0 | divided_by: cspan | plus: 16 -%}

{%- assign cx = co2 | minus: 400 | times: 1000.0 | divided_by: 1600 -%}
{%- if cx < 0 -%}{%- assign cx = 0 -%}{%- endif -%}
{%- if cx > 1000 -%}{%- assign cx = 1000 -%}{%- endif -%}
{%- if co2 < 800 -%}{%- assign cstat = C1 -%}{%- assign copac = '0.08' -%}
{%- elsif co2 < 1000 -%}{%- assign cstat = C2 -%}{%- assign copac = '0.18' -%}
{%- elsif co2 < 1500 -%}{%- assign cstat = C3 -%}{%- assign copac = '0.36' -%}
{%- elsif co2 < 2000 -%}{%- assign cstat = C4 -%}{%- assign copac = '0.62' -%}
{%- else -%}{%- assign cstat = C5 -%}{%- assign copac = '0.85' -%}
{%- endif -%}

{%- assign co2raw = trmnl.plugin_settings.custom_fields_values.co2_threshold | default: '1500' -%}
{%- assign co2open = co2raw | plus: 0 -%}
{%- if co2open <= 0 -%}{%- assign co2open = 1500 -%}{%- endif -%}
{%- assign tin = v_tin -%}
{%- assign tdiff = tin | minus: tnow -%}
{%- if has_co2 == false and has_tin == false -%}
  {%- assign wopen = false -%}{%- assign wtxt = DASH -%}
{%- elsif co2 >= 2000 -%}{%- assign wopen = true -%}{%- assign wtxt = W1 -%}
{%- elsif co2 >= co2open -%}{%- assign wopen = true -%}{%- assign wtxt = W2 -%}
{%- elsif tin > 23.0 and tdiff > 1.0 -%}{%- assign wopen = true -%}{%- assign wtxt = W3 -%}
{%- elsif tdiff < -1.0 -%}{%- assign wopen = false -%}{%- assign wtxt = W4 -%}
{%- else -%}{%- assign wopen = false -%}{%- assign wtxt = W5 -%}{%- endif -%}

{%- case IDX_5.state -%}
  {%- when 'up' -%}{%- assign ta = '&#8599;' -%}
  {%- when 'down' -%}{%- assign ta = '&#8600;' -%}
  {%- else -%}{%- assign ta = '&#8594;' -%}
{%- endcase -%}
{%- case IDX_6.state -%}
  {%- when 'up' -%}{%- assign ia = '&#8599;' -%}
  {%- when 'down' -%}{%- assign ia = '&#8600;' -%}
  {%- else -%}{%- assign ia = '&#8594;' -%}
{%- endcase -%}
{%- assign offline = false -%}
{%- if IDX_10.state != 'on' -%}{%- assign offline = true -%}{%- endif -%}

<div class="view view--full">
  <div class="layout">
    <div style="display:flex; flex-direction:column; width:100%; height:100%; box-sizing:border-box; gap:8px;">

      {%- if nodata -%}
      <div style="flex:1 1 auto; display:flex; flex-direction:column; align-items:center;
                  justify-content:center; gap:18px;">
        <svg viewBox="0 0 96 96" style="width:96px; height:96px;">
          <path d="M26 62 A16 16 0 1 1 30 34 A22 22 0 0 1 72 40 A13 13 0 0 1 70 62 Z"
                fill="none" stroke="#000" stroke-width="3.5" stroke-linejoin="round"/>
          <line x1="14" y1="86" x2="82" y2="10" stroke="#000" stroke-width="4"/>
        </svg>
        <div style="font-size:30px; letter-spacing:.03em;">{{ L_nodata }}</div>
        <div style="font-size:20px; opacity:.6;">{{ L_nodata2 }}</div>
      </div>
      {%- else -%}

      <div style="display:flex; align-items:stretch; gap:30px; width:100%;">
        <div style="flex:1.25; min-width:0;">
          <div style="display:flex; align-items:baseline; gap:12px;">
            <span style="font-size:22px; letter-spacing:.06em; text-transform:uppercase; opacity:.65;">{{ L_out }}</span>
            {%- if offline -%}
            <span style="font-size:19px; font-weight:600; background:#000; color:#fff; padding:2px 9px;">{{ L_offline }}</span>
            {%- else -%}
            <span style="font-size:19px; opacity:.5;">{{ L_batt }} {% if has_batt %}{{ v_batt | round: 0 }} %{% else %}{{ DASH }}{% endif %}</span>
            {%- endif -%}
          </div>
          <div style="display:flex; align-items:center; gap:18px;">
            <div style="display:flex; align-items:baseline; gap:14px;">
              <span style="font-size:84px; line-height:1.05; font-weight:300;">{% if has_tout %}{{ tnow | round: 1 }}&deg;{% else %}{{ DASH }}{% endif %}</span>
              <span style="font-size:32px; line-height:1;">{{ ta }}</span>
            </div>
            {%- assign tw = v_tout -%}
            {%- assign warn = 'none' -%}
            {%- unless has_tout -%}{%- assign tw = 15.0 -%}{%- endunless -%}
            {%- if tw < 1 -%}{%- assign warn = 'frost' -%}{%- assign warntxt = N1 -%}
            {%- elsif tw < 4 -%}{%- assign warn = 'frost' -%}{%- assign warntxt = N2 -%}
            {%- elsif tw > 31 -%}{%- assign warn = 'heathot' -%}{%- assign warntxt = N3 -%}
            {%- elsif tw > 26 -%}{%- assign warn = 'heat' -%}{%- assign warntxt = N4 -%}
            {%- endif -%}
            {%- if warn != 'none' -%}
            <div style="display:flex; align-items:center; gap:9px;">
              <svg viewBox="0 0 48 48" style="width:44px; height:44px; display:block;">
                {%- if warn == 'frost' -%}
                <g stroke="#000" stroke-width="3" stroke-linecap="round" fill="none">
                  <line x1="24" y1="5" x2="24" y2="43"/>
                  <line x1="7.5" y1="14.5" x2="40.5" y2="33.5"/>
                  <line x1="40.5" y1="14.5" x2="7.5" y2="33.5"/>
                  <line x1="24" y1="12" x2="18.5" y2="6.5"/><line x1="24" y1="12" x2="29.5" y2="6.5"/>
                  <line x1="24" y1="36" x2="18.5" y2="41.5"/><line x1="24" y1="36" x2="29.5" y2="41.5"/>
                  <line x1="13.6" y1="18" x2="6.6" y2="18"/><line x1="13.6" y1="18" x2="10.1" y2="12"/>
                  <line x1="34.4" y1="30" x2="41.4" y2="30"/><line x1="34.4" y1="30" x2="37.9" y2="36"/>
                  <line x1="34.4" y1="18" x2="41.4" y2="18"/><line x1="34.4" y1="18" x2="37.9" y2="12"/>
                  <line x1="13.6" y1="30" x2="6.6" y2="30"/><line x1="13.6" y1="30" x2="10.1" y2="36"/>
                </g>
                {%- else -%}
                <circle cx="24" cy="24" r="9" stroke="#000" stroke-width="3"
                        fill="{% if warn == 'heathot' %}#000{% else %}none{% endif %}"/>
                <g stroke="#000" stroke-width="3" stroke-linecap="round">
                  <line x1="24" y1="3" x2="24" y2="10"/><line x1="24" y1="38" x2="24" y2="45"/>
                  <line x1="3" y1="24" x2="10" y2="24"/><line x1="38" y1="24" x2="45" y2="24"/>
                  <line x1="9.2" y1="9.2" x2="14.2" y2="14.2"/><line x1="33.8" y1="33.8" x2="38.8" y2="38.8"/>
                  <line x1="38.8" y1="9.2" x2="33.8" y2="14.2"/><line x1="14.2" y1="33.8" x2="9.2" y2="38.8"/>
                </g>
                {%- endif -%}
              </svg>
              <span style="font-size:21px; font-weight:600; white-space:nowrap;">{{ warntxt }}</span>
            </div>
            {%- endif -%}
          </div>
          <div style="font-size:26px;">{% if has_hout %}{{ v_hout | round: 0 }} %{% else %}{{ DASH }}{% endif %} {{ L_hum }}</div>
        </div>

        <div style="width:2px; background:#000; opacity:.18;"></div>

        <div style="flex:1.35; min-width:0; display:flex; flex-direction:column;">
          <span style="font-size:22px; letter-spacing:.06em; text-transform:uppercase; opacity:.65;">{{ L_in }}</span>
          <div style="display:flex; align-items:center; width:100%;">
            <div>
              <div style="display:flex; align-items:baseline; gap:12px;">
                <span style="font-size:84px; line-height:1.05; font-weight:300;">{% if has_tin %}{{ tin | round: 1 }}&deg;{% else %}{{ DASH }}{% endif %}</span>
                <span style="font-size:32px; line-height:1;">{{ ia }}</span>
              </div>
              <div style="font-size:26px;">{% if has_hin %}{{ v_hin | round: 0 }} %{% else %}{{ DASH }}{% endif %} {{ L_hum }}</div>
            </div>
            <div style="margin-left:auto; display:flex; flex-direction:column; align-items:center; gap:2px;">
              <svg viewBox="0 0 56 52" style="width:54px; height:50px; display:block;">
                {%- if wopen -%}
                <rect x="2" y="4" width="20" height="44" fill="none" stroke="#000" stroke-width="3.5"/>
                <line x1="12" y1="4" x2="12" y2="48" stroke="#000" stroke-width="2"/>
                <polygon points="26,4 54,0 54,52 26,48" fill="none" stroke="#000" stroke-width="3.5"/>
                {%- else -%}
                <rect x="5" y="4" width="46" height="44" fill="none" stroke="#000" stroke-width="3.5"/>
                <line x1="28" y1="4" x2="28" y2="48" stroke="#000" stroke-width="3"/>
                <line x1="5" y1="26" x2="51" y2="26" stroke="#000" stroke-width="3"/>
                {%- endif -%}
              </svg>
              <span style="font-size:22px; font-weight:600; white-space:nowrap;">{{ L_win }} {% if wopen %}{{ L_open }}{% else %}{{ L_closed }}{% endif %}</span>
              <span style="font-size:19px; opacity:.6; white-space:nowrap;">{{ wtxt }}</span>
            </div>
          </div>
        </div>
      </div>

      <div style="width:100%;">
        <div style="display:flex; justify-content:space-between; align-items:baseline; font-size:21px; white-space:nowrap;">
          <span style="opacity:.65; letter-spacing:.04em; text-transform:uppercase;">{{ L_co2now }}</span>
          <span style="font-size:24px;"><span style="display:inline-block; width:20px; height:20px; background:#000; opacity:{{ copac }}; border:1.5px solid rgba(0,0,0,.5); vertical-align:-2px; margin-right:7px;"></span>{% if has_co2 %}{{ cstat }} &middot; <strong>{{ v_co2 | round: 0 }} ppm</strong>{% else %}<strong>{{ DASH }}</strong>{% endif %}</span>
        </div>
        <svg viewBox="0 0 1000 58" style="width:100%; height:auto; display:block; overflow:visible;">
          <rect x="0"     y="4" width="250"   height="24" fill="#000" fill-opacity=".08"/>
          <rect x="250"   y="4" width="125"   height="24" fill="#000" fill-opacity=".18"/>
          <rect x="375"   y="4" width="312.5" height="24" fill="#000" fill-opacity=".36"/>
          <rect x="687.5" y="4" width="312.5" height="24" fill="#000" fill-opacity=".62"/>
          <rect x="0" y="4" width="1000" height="24" fill="none" stroke="#000" stroke-opacity=".5" stroke-width="1.5"/>
          <line x1="375" y1="0" x2="375" y2="32" stroke="#000" stroke-opacity=".55" stroke-width="2" stroke-dasharray="4 3"/>
          <rect x="{{ cx | minus: 2.5 | round: 1 }}" y="0" width="5" height="32" fill="#000"/>
          <text x="0"     y="52" font-size="19" text-anchor="start"  fill="#000" fill-opacity=".75">400</text>
          <text x="250"   y="52" font-size="19" text-anchor="middle" fill="#000" fill-opacity=".75">800</text>
          <text x="375"   y="52" font-size="19" text-anchor="middle" fill="#000" fill-opacity=".75">1000</text>
          <text x="687.5" y="52" font-size="19" text-anchor="middle" fill="#000" fill-opacity=".75">1500</text>
          <text x="1000"  y="52" font-size="19" text-anchor="end"    fill="#000" fill-opacity=".75">2000 ppm</text>
        </svg>
      </div>

      <div style="width:100%;">
        <div style="display:flex; justify-content:space-between; align-items:baseline; font-size:21px; white-space:nowrap;">
          <span style="opacity:.65; letter-spacing:.04em; text-transform:uppercase;">{{ L_tchart }} &middot; 24 h</span>
          <span style="font-size:23px;">min <strong>{{ tmin | round: 1 }}&deg;</strong> &middot; max <strong>{{ tmax | round: 1 }}&deg;</strong></span>
        </div>
        <svg viewBox="0 0 1000 185" style="width:100%; height:auto; display:block; overflow:visible;">
          <line x1="78" y1="16"   x2="960" y2="16"   stroke="#000" stroke-opacity=".45" stroke-width="2" stroke-dasharray="9 7"/>
          <line x1="78" y1="90.5" x2="960" y2="90.5" stroke="#000" stroke-opacity=".45" stroke-width="2" stroke-dasharray="9 7"/>
          <line x1="78" y1="165"  x2="960" y2="165"  stroke="#000" stroke-opacity=".45" stroke-width="2" stroke-dasharray="9 7"/>
          <text x="68" y="23"    font-size="21" text-anchor="end" fill="#000" fill-opacity=".85">{{ tmax | round: 0 }}&deg;</text>
          <text x="68" y="97.5" font-size="21" text-anchor="end" fill="#000" fill-opacity=".85">{{ tmid | round: 0 }}&deg;</text>
          <text x="68" y="172"   font-size="21" text-anchor="end" fill="#000" fill-opacity=".85">{{ tmin | round: 0 }}&deg;</text>
          <polyline points="{{ tpoly }}" fill="none" stroke="#000" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round"/>
          {%- if has_tout -%}<circle cx="960" cy="{{ tcy | round: 1 }}" r="7.5" fill="#000"/>{%- endif -%}
        </svg>
      </div>

      <div style="width:100%;">
        <div style="display:flex; justify-content:space-between; align-items:baseline; font-size:21px; white-space:nowrap;">
          <span style="opacity:.65; letter-spacing:.04em; text-transform:uppercase;">{{ L_cchart }} &middot; 24 h</span>
          <span style="font-size:23px;">min <strong>{{ cmin | round: 0 }}</strong> &middot; max <strong>{{ cmax | round: 0 }} ppm</strong></span>
        </div>
        <svg viewBox="0 0 1000 215" style="width:100%; height:auto; display:block; overflow:visible;">
          <line x1="78" y1="16"  x2="960" y2="16"  stroke="#000" stroke-opacity=".45" stroke-width="2" stroke-dasharray="9 7"/>
          <line x1="78" y1="92" x2="960" y2="92" stroke="#000" stroke-opacity=".45" stroke-width="2" stroke-dasharray="9 7"/>
